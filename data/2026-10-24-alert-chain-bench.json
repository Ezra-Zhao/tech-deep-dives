{
 "generated_at_local": "2026-10-24 19:19:30 UTC",
 "lab": "/home/hatch/workspace/oxide-proofs/net-assurance-lab",
 "rules_group": {
  "name": "net-assurance-lab.rules",
  "interval": "15s",
  "count": 10
 },
 "rules": [
  {
   "alert": "NalBaselineHighPacketLoss",
   "expr": "nal_loss_ratio{scenario=~\"baseline_.*\"} > 0.05",
   "for": "1m",
   "severity": "warning"
  },
  {
   "alert": "NalBaselineP99LatencyHigh",
   "expr": "nal_rtt_ms{scenario=~\"baseline_.*\", stat=\"p99\"} > 50",
   "for": "1m",
   "severity": "warning"
  },
  {
   "alert": "NalBaselineThroughputCollapse",
   "expr": "nal_throughput_pps{kind=\"echo\", scenario=~\"baseline_.*\"} < 0.5 * nal_throughput_pps{kind=\"send\", scenario=~\"baseline_.*\"}",
   "for": "1m",
   "severity": "warning"
  },
  {
   "alert": "NalFaultLossAboveInjectionBand",
   "expr": "nal_loss_ratio{scenario=\"fault_sustained\"} > 0.75",
   "for": "1m",
   "severity": "warning"
  },
  {
   "alert": "NalFaultP99LatencyExtreme",
   "expr": "nal_rtt_ms{scenario=\"fault_sustained\", stat=\"p99\"} > 1000",
   "for": "1m",
   "severity": "warning"
  },
  {
   "alert": "NalLinkFlapDetected",
   "expr": "nal_link_flap_detected == 1",
   "for": "15s",
   "severity": "info"
  },
  {
   "alert": "NalFlapShareDominatesLoss",
   "expr": "nal_fault_proxy_drop_ratio{cause=\"flap\"} > nal_fault_proxy_drop_ratio{cause=\"loss\"}",
   "for": "1m",
   "severity": "info"
  },
  {
   "alert": "NalMalformedPacketEchoed",
   "expr": "nal_malformed_echoed_total > 0",
   "for": "0s",
   "severity": "critical"
  },
  {
   "alert": "NalResultsStale",
   "expr": "nal_results_age_seconds > 86400",
   "for": "5m",
   "severity": "warning"
  },
  {
   "alert": "NalExporterResultsMissing",
   "expr": "nal_exporter_results_present == 0",
   "for": "1m",
   "severity": "critical"
  }
 ],
 "prometheus_config": {
  "scrape_interval": "5s",
  "evaluation_interval": "5s",
  "alertmanagers": [],
  "rule_files": [
   "rules/*.yml"
  ]
 },
